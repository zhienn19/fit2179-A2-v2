{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Dengue Mortality Risk vs Age (2012-2021)",
  "width": "container",
  "height": 400,
  "data": {
    "url": "dengue_demographics_malaysia.csv" 
  },

  "layer": [
    { "mark": {
    "type": "bar", "cursor": "pointer"},
    "params": [{
      "name": "age_group_select",
      "select": {
        "type": "point",
        "fields": ["Age_Group"],
        "clear": "dblclick"
      },
      "value": [{"Age_Group": "45-59"}]
    }]
},
  {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "purple",
        "stroke": "#000000",
        "cornerRadius": 4,
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "value":1090
        },
        "x2": {
          "value": 820
        },
        "y": {
          "value": 35
        },
        "y2": {
          "value": 110
        }, "tooltip":null
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Age Group of 45-59 has higher mortality risk', 'when they are infected with Dengue Fever. Factors', 'such as delayed treatment or unmonitored', 'underlying health risks require urgent care can be', 'put into consideration.']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fill": "#111111"
      },
      "encoding": {
        "x": {
          "value": 830
        },
        "y": {
          "value": 48
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }, "tooltip":null

      }
    }
  ],

  "encoding": {
    "x": {
      "field": "Age_Group", 
      "type": "ordinal", 
      "title": "Age Group",
      "axis": {"labelAngle": 0}
    },
   
    "y": {
      "field": "Number of Deaths",
      "type": "quantitative",
      "title": "Number of Deaths"
    },

    "color": {
      "condition": {
        "param": "age_group_select",
        
        "value": "#8531b5"
      },
      "value": "#d1d1d1"
    },


    "tooltip": [
        {"field": "Number of Deaths", "title": "Number of Deaths"},
        {"field": "Age_Group", "title": "Age Group"},
        {"field": "Percentage", "title": "Percentage(%)"}
    ]
  }
}