{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Reported Dengue Cases from Year 2009 to 2019",
  "width": "container",
  "height": 300,
  "data": {
    "url": "DatasetDenggiMalaysia_v2.csv" 
  },
  "transform": [
    
    {
      "calculate": "datum.TAHUN", 
      "as": "Negeri"
    },
    {
      "filter": "datum.TAHUN != 'NEGERI'"
    },
    {
      "fold": ["1999", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019"],
      "as": ["Year", "Cases"]
    },
    {
      "calculate": "toNumber(datum.Cases)",
      "as": "Cases_Num"
    },
    {"filter": "datum.Year >= 2009"}
  ],

  "layer": [
    {
      "mark": {"type":"line", "point":true, "strokeWidth": 3}
    },
     {
      "mark": {"type":"point"}
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "purple",
        "stroke": "#000000",
        "cornerRadius": 4,
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value":360
        },
        "x2": {
          "value": 490
        },
        "y": {
          "value": 5
        },
        "y2": {
          "value": 40
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Year 2019 recorded the', 'highest during this timeline.', 'Potentially caused by', 'city developments.']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fill": "#c8863c"
      },
      "encoding": {
        "x": {
          "value": 360
        },
        "y": {
          "value": 12
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }, "tooltip": null

      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "purple",
        "stroke": "#000000",
        "cornerRadius": 4,
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value":180
        },
        "x2": {
          "value": 300
        },
        "y": {
          "value": 250
        },
        "y2": {
          "value": 285
        }, "tooltip": null
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Year 2011 had', 'the lowest']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fill": "#c8863c"
      },
      "encoding": {
        "x": {
          "value": 90
        },
        "y": {
          "value": 275
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }, "tooltip":null

      }
    }
  ],
  
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "sort": {"field": "Year"},
      "axis": {"labelAngle": 360}
    },
    "y": {
      "aggregate": "sum",
      "field": "Cases_Num",
      "type": "quantitative",
      "title": "Number of Cases"
    },
    "tooltip": [
      {"field": "Year", "title": "Year"},
      {"aggregate": "sum", "field": "Cases_Num", "title": "Number of Cases", "format": ","}
    ],

    "color": {"value": "#8531b5"}

  }
  
}