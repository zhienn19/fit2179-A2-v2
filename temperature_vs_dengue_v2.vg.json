{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Temperature vs Dengue Case Occurence",
  "width": 600,
  "height": 400,
  "data": {
    "url": "monthly_dengue_weather_malaysia.csv" 
  },

  "mark": {"type": "point", "filled": true, "size": 70, "opacity": 0.35},
  "encoding": {
    "x": {
      "field": "temperature",
      "type": "quantitative",
      "title": "Average Temperature (Celcius)",
      "axis": {"labelAngle": 360},
      "scale": {"nice": true, "zero": false, "domainMin": 25, "domainMax": 30}
    },
    "y": {
      "field": "cases",
      "type": "quantitative",
      "title": "Number of Cases",
      "scale": {"nice": true}
    },

    "tooltip": [
      {"field": "Avg_Temp_C", "title": "Average Temperature (Celcius)", "format": ".1f"},
      {"field": "Dengue_Cases", "title": "Total Cases", "type": "quantitative"}
    ],
    "color": {"value": "#8531b5"}
  }
}