{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Number of Deaths by Dengue from 2012 to 2021",
  "width": "container",
  "height": 300,
  "data": {
    "url": "dengue_mortality_trends_malaysia.csv" 
  },

  "transform": [
    {
      "sort": [{"field": "Year"}],
      "window": [{
        "op": "sum",
        "field": "Number_of_Deaths",
        "as": "Cumulative_Deaths"
      }]
    }
  ],
  "layer": [
   { "mark": {
    "type": "area",
    "line": {
      "strokeWidth": 3
    },
    "opacity": 0.3
  }},
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Year 2015 recorded', 'the most deaths']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fill": "#c8863c"
      },
      "encoding": {
        "x": {
          "value": 220
        },
        "y": {
          "value": 15
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }

      }
    }
  ],
  
  

  "encoding": {
    "x": {
      "field": "Year", 
      "type": "ordinal", 
      "title": "Year",
      "axis": {"labelAngle": 360}
    },
   
    "y": {
      "field": "Number_of_Deaths",
      "type": "quantitative",
      "title": "Number of Deaths"
    },
    "tooltip": [
        { "field": "Year", "title": "Year"},
        {"field": "Number_of_Deaths", "title": "Number of Deaths"},
        {"field": "Cumulative_Deaths", "type": "quantitative", "title": "Cumulative Deaths to Date"}
    ],
    "color": {"value": "#8531b5"}
  }
}