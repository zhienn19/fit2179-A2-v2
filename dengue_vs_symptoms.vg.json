{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "height": 355,
    "width": 600,
     "autosize": {
        "type": "fit",
        "contains": "content"
                },

    "title": "Most Common Symptoms in Dengue Patients",
    "data": {
        "url": "dengue_symptoms_extended.csv"
    },
    "layer": [
        {"mark": {"type": "bar", "cursor": "pointer"},
        "params": [
            {
                "name": "symptoms_select",
                "select": {
                    "type": "point",
                    "fields": ["Symptom"],
                    "clear": "dblclick"
                },
                "value": [{"Symptom": "Persistent Vomiting"}]
            }
        ]
}
        
    ],
    "encoding": {
        "y": {
            "field": "Symptom",
            "type": "nominal",
            "title": "Symptom",
            "axis": {"offset": 0.2, "domainColor": "black"},
            "sort":"x"
            
       
        },
        "x": {
            "field": "Overall_Patients_Count",
            "type": "quantitative",
            "title": "Number of Patients",
            "scale": {"domain": [0, 210]},
            "axis": {"offset": 0.5}

        },

    "color": {
      "condition": {
        "param": "symptoms_select",
        "value": "#8531b5"
      },
      "value": "#cbd5e1"
        
    },
    "tooltip": [
      {"field": "Symptom", "type": "nominal", "title": "Symptom"},
      {"field": "Overall_Patients_Count", "title": "Number of Patients"}
    ]
  
    }
}