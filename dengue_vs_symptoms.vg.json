{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "height": 355,
    "width": 600,
     "autosize": {
        "type": "fit",
        "contains": "content"
                },

    "title": "Most Common Symptoms in Dengue Patients",
    "data": {
        "url": "dengue_symptoms_extended.csv"
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "cursor": "pointer"
            },
            "params": [
                {
                    "name": "symptoms_select",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Symptom"
                        ],
                        "clear": "dblclick"
                    },
                    "value": [
                        {
                            "Symptom": "Persistent Vomiting"
                        }
                    ]
                }
            ]
        },
        {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "purple",
        "stroke": "#000000",
        "cornerRadius": 4,
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "value":445
        },
        "x2": {
          "value": 180
        },
        "y": {
          "value": 10
        },
        "y2": {
          "value": 65
        }, "tooltip":null
      }
    },
        {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Most patients who are infected with Dengue fever', 'are likely to suffer from Persistent Vomitting', 'followed by Abdominal Pain and feeling Lethargic.']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fill": "#111111"
      },
      "encoding": {
        "x": {
          "value": 190
        },
        "y": {
          "value": 25
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }, "tooltip":null

      }
    }
    ],
    "encoding": {
        "y": {
            "field": "Symptom",
            "type": "nominal",
            "title": "Symptoms",
            "axis": {"offset": 0.2, "domainColor": "black"},
            "sort":"x"
            
       
        },
        "x": {
            "field": "Overall_Patients_Count",
            "type": "quantitative",
            "title": "Number of Patients",
            "scale": {"domain": [0, 210]},
            "axis": {"offset": 0.5}

        },

    "color": {
      "condition": {
        "param": "symptoms_select",
        "value": "#8531b5"
      },
      "value": "#d1d1d1"
        
    },
    "tooltip": [
      {"field": "Symptom", "type": "nominal", "title": "Symptom"},
      {"field": "Overall_Patients_Count", "title": "Number of Patients"}
    ]
  
    }
}