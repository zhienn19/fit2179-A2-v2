{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Reported Dengue Cases by Age Group from 2018 to 2021",
  "width": "container",
  "height": 300,
  "data": {
    "url": "dengue_age.csv" 
  },
  
  "layer": [
    {
      "mark": {"type":"bar", "cursor": "pointer"},
      "params": [{
        "name": "age_category_select",
        "select": {
          "type": "point",
          "fields": ["Age_Category"],
          "clear": "dblclick"
        },
        "value": [{"Age_Category": "20-39"}]
      }]
    },
      {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "purple",
        "stroke": "#000000",
        "cornerRadius": 4,
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "value":430
        },
        "x2": {
          "value": 270
        },
        "y": {
          "value": 30
        },
        "y2": {
          "value": 65
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Age Group of 20-39', 'are more prone to Dengue Fever']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fill": "#111111"
      },
      "encoding": {
        "x": {
          "value": 275
        },
        "y": {
          "value": 43
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }

      }
    }
    
  ],
  
  "encoding": {
    "x": {
      "field": "Age_Category",
      "type": "nominal",
      "title": "Age Group",
      "sort": {"field": "Age_Category"},
      "axis": {"labelAngle": 0}
    },
    "y": {
      "aggregate": "sum",
      "field": "Cases",
      "type": "quantitative",
      "title": "Total Cases"
    },
    "tooltip": [
      {"field": "Age_Category", "title": "Age Group"},
      {"aggregate": "sum", "field": "Cases", "title": "Total Cases"}
    ],
    "color": {
      "condition": {
        "param": "age_category_select",
        "value": "#8531b5"
      },
      "value": "#d1d1d1"
    }
  }
}