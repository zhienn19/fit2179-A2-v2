{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Reported Dengue Cases by Age Group from 2018 to 2021",
  "width": "container",
  "height": 300,
  "data": {
    "url": "dengue_age.csv" 
  },
  
  "layer": [
    {
      "mark": {"type":"bar", "cursor": "pointer"},
      "params": [{
        "name": "age_category_select",
        "select": {
          "type": "point",
          "fields": ["Age_Category"],
          "clear": "dblclick"
        },
        "value": [{"Age_Category": "20-39"}]
      }]
    }
    
  ],
  
  "encoding": {
    "x": {
      "field": "Age_Category",
      "type": "nominal",
      "title": "Age Group",
      "sort": {"field": "Age_Category"},
      "axis": {"labelAngle": 0}
    },
    "y": {
      "aggregate": "sum",
      "field": "Cases",
      "type": "quantitative",
      "title": "Total Cases"
    },
    "tooltip": [
      {"field": "Age_Category", "title": "Age Group"},
      {"aggregate": "sum", "field": "Cases", "title": "Total Cases"}
    ],
    "color": {
      "condition": {
        "param": "age_category_select",
        "value": "#8531b5"
      },
      "value": "#cbd5e1"
    }
  }
}