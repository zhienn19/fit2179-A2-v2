{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Yearly Average Temperature vs Dengue Case Occurence",
  "width": "container",
  "height": 300,
  "data": {
    "url": "Dengue_Climate_Malaysia_2018_2021_v2.csv" 
  },
  "layer": [
    {"mark": {"type": "point", "filled": true, "size": 70, "opacity": 0.35,
    "stroke": "#2c3e50",
    "strokeWidth": 0.8}},
      {
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "calculate": "['Yearly Average Temperature around 29℃', 'had the most cases. Warmer temperature', 'speeds up mosquito incubation period.']",
          "as": "box_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fill": "#c8863c"
      },
      "encoding": {
        "x": {
          "value": 250
        },
        "y": {
          "value": 20
        },
        "text": {
          "field": "box_text",
          "type": "nominal"
        }, "tooltip":null

      }
    }
  ],
  
  "encoding": {
    "x": {
      "field": "Avg_Temp_C",
      "type": "quantitative",
      "title": "Yearly Average Temperature (℃)",
      "axis": {"labelAngle": 360},
      "scale": {"nice": true, "zero": false, "domainMin": 25, "domainMax": 30}
    },
    "y": {
      "field": "Dengue_Cases",
      "type": "quantitative",
      "title": "Number of Cases",
      "scale": {"nice": true}
    },

    "tooltip": [
      {"field": "Avg_Temp_C", "title": "Average Temperature (℃)", "format": ".1f"},
      {"field": "Dengue_Cases", "title": "Total Cases", "type": "quantitative"}
    ],
    "color": {"value": "#8531b5"}
  }
}